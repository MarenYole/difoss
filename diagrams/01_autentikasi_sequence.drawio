          <mxGeometry x="45" y="440" width="10" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="Buka Aplikasi &amp; Pilih Login" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1429;entryX=0;entryY=0.0;" edge="1" parent="1" source="u" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="Minta Verifikasi Sidik Jari / Face ID" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1111;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act0">
