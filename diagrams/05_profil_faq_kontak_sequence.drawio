        <mxCell id="m1" value="Validasi Format Email &amp; Kelengkapan Teks" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1351;entryX=1;entryY=0.2162;" edge="1" parent="1" source="act2" target="act2">
