        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="gw">
          <mxGeometry x="45" y="210" width="10" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="Isi Form Kontak (Nama, Email, Pesan)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1636;entryX=0;entryY=0.0;" edge="1" parent="1" source="u" target="act2">
          <mxGeometry relative="1" as="geometry"/>
