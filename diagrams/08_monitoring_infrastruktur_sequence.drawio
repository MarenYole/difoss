<mxfile>
  <diagram id="seqlayout" name="Sequence Diagram - Pemantauan Kesehatan Server &amp; Evaluasi Alert">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="agent" value="Agent Server Klien" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="100" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API Ingest DIFOSS" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="310" y="40" width="100" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="Metric Worker Service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="100" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="850" y="40" width="100" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="Aplikasi Mobile Staf/Klien" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="1120" y="40" width="100" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="db">
          <mxGeometry x="45" y="140" width="10" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="act1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="api">
          <mxGeometry x="45" y="90" width="10" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="act2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="worker">
          <mxGeometry x="45" y="190" width="10" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="POST /telemetry (CPU, RAM, Disk, Status)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.15;entryX=0;entryY=0.0;" edge="1" parent="1" source="agent" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="INSERT ke infrastructure_metrics" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.119;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="Enqueue Data Metrik Baru" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=1;exitY=0.2381;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="Evaluasi Nilai Metrik terhadap Threshold" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1351;entryX=1;entryY=0.2162;" edge="1" parent="1" source="act2" target="act2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="690" y="280"/><mxPoint x="690" y="310"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="INSERT Log ke infrastructure_alerts (Jika Melampaui)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3243;entryX=0;entryY=0.5312;" edge="1" parent="1" source="act2" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="GET /infrastructure/status (Bearer JWT)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.6;entryX=1;entryY=0.6429;" edge="1" parent="1" source="app" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="Query Kondisi Terkini &amp; Alert Aktif" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.7619;entryX=0;entryY=0.8438;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="Data Status &amp; Grafik Realtime" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.881;" edge="1" parent="1" source="act0" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="200 OK (Kirim Ringkasan Health Status)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=1;exitY=1.0;entryX=0.5;entryY=0.85;" edge="1" parent="1" source="act1" target="app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
