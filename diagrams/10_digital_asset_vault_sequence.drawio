        <mxCell id="act4" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="app">
          <mxGeometry x="45" y="90" width="10" height="570" as="geometry"/>
        </mxCell>
        <mxCell id="act5" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="gw">
          <mxGeometry x="45" y="140" width="10" height="570" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="Pilih Dokumen Proyek &amp; Klik Unduh" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.12;entryX=0;entryY=0.0;" edge="1" parent="1" source="k" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="GET /vault/assets/{id}/download (Bearer JWT)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0877;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act5">
          <mxGeometry relative="1" as="geometry"/>
