<mxfile>
  <diagram id="seqlayout" name="Sequence Diagram - Pengunduhan Dokumen Vault Terenkripsi">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="k" value="Klien" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=nowrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;participant=umlActor;verticalAlign=bottom;spacingBottom=-18;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="75" y="40" width="30" height="750" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="Aplikasi Mobile" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="100" height="750" as="geometry"/>
        </mxCell>
        <mxCell id="gw" value="API Gateway (Auth)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="100" height="750" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="Vault Service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="700" y="40" width="100" height="750" as="geometry"/>
