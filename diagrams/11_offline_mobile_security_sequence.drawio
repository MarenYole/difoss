        <mxCell id="act2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="api">
          <mxGeometry x="45" y="380" width="10" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="gw">
          <mxGeometry x="45" y="260" width="10" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="act4" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="cache">
          <mxGeometry x="45" y="580" width="10" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="Koneksi Jaringan Kembali Tersedia (Online)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1343;entryX=0.5;entryY=0.1791;" edge="1" parent="1" source="app" target="app">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="150" y="130"/><mxPoint x="150" y="160"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m1" value="Ambil Antrean Perubahan Tertunda (Drafts)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.2388;entryX=0;entryY=0.0;" edge="1" parent="1" source="app" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="Paket Data Tertunda (Payload Offline)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.3134;" edge="1" parent="1" source="act0" target="app">
